# ===========================================================
#  متغیرهای محیط (Environment Variables) — Supabase
#  این فایل الگوی نمونه است؛ آن را به .env کپی کرده و مقادیر را پر کنید.
#  روی Vercel این مقادیر را در Project Settings → Environment Variables تنظیم کنید.
# ===========================================================

# ──────────────────── Supabase Connection Strings ────────────────────
# در Supabase Dashboard → Project → Project Settings → Database → Connection string
# دو URL وجود دارد: «Transaction» (pooler) و «Direct connection»
#هر دو را کپی و در متغیرهای زیر قرار دهید (رمز را جایگزین کنید).

# ۱) DATABASE_URL — اتصال pooler شده (پورت 6543) — برای runtime برنامه
#    (در serverless اتصال pooler مهم است تا connection exhaustion رخ ندهد)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&prepared_statement_suffix=$1"

# ۲) DIRECT_URL — اتصال مستقیم (پورت 5432) — فقط برای migration / prisma db push
#    (PgBouncer در حالت transaction pooler، prepared statements را پشتیبانی نمی‌کند
#     که برای Prisma Migrate لازم است)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ──────────────────── مثال واقعی (جایگزین کنید) ────────────────────
# DATABASE_URL="postgresql://postgres.abcdefghijklmno:MySecretPassword123@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&prepared_statement_suffix=$1"
# DIRECT_URL="postgresql://postgres.abcdefghijklmno:MySecretPassword123@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# ──────────────────── محیط اجرا ────────────────────
# در Vercel به‌صورت خودکار "production" تنظیم می‌شود.

# ──────────────────── اختیاری ────────────────────
# NEXT_PUBLIC_SITE_URL="https://your-project.vercel.app"
# NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY=""
