# ===========================================================
#  متغیرهای محیط (Environment Variables)
#  این فایل الگوی نمونه است؛ آن را به .env کپی کرده و مقادیر را پر کنید.
#  روی Vercel این مقادیر را در Project Settings → Environment Variables تنظیم کنید.
# ===========================================================

# --- دیتابیس (DATABASE) ---
# حالت لوکال توسعه (SQLite):
DATABASE_URL="file:./db/custom.db"

# حالت پروداکشن روی Vercel — یکی از گزینه‌های زیر را انتخاب کنید:
# 1) Vercel Postgres (توصیه‌شده):postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/dbname?sslmode=require
# 2) MySQL (PlanetScale / TiDB): mysql://user:password@host:3306/dbname
# 3) PostgreSQL (Neon / Supabase):
#    postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
#
# نکته مهم: وقتی به MySQL/PostgreSQL سوئیچ می‌کنید، در `prisma/schema.prisma`
# نیز `provider` را از `"sqlite"` به `"mysql"` یا `"postgresql"` تغییر دهید.

# --- محیط اجرا (NODE_ENV) ---
# در Vercel به‌صورت خودکار "production" تنظیم می‌شود؛ برای توسعه لوکال:
# NODE_ENV="development"

# --- اختیاری: آدرس سایت (برای تولید لینک‌های مطلق) ---
# NEXT_PUBLIC_SITE_URL="https://your-project.vercel.app"

# --- اختیاری: تنظیمات Z-AI SDK (در صورت استفاده از قابلیت‌های AI) ---
# ZAI_API_KEY=""
