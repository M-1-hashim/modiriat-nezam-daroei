# ===========================================================
#  متغیرهای محیط (Environment Variables)
#  این فایل الگوی نمونه است؛ آن را به .env کپی کرده و مقادیر را پر کنید.
#  روی Vercel این مقادیر را در Project Settings → Environment Variables تنظیم کنید.
# ===========================================================

# --- دیتابیس (DATABASE) ---
# provider در prisma/schema.prisma روی "postgresql" تنظیم شده است.
# گزینه‌های توصیه‌شده برای Vercel:
#
# 1) Neon Postgres (رایگان، توصیه‌شده):
#    https://neon.tech → بسازید → connection string را کپی کنید:
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"
#
# 2) Vercel Postgres (یک‌کلیک از داشبورد Vercel → Storage → Create Database):
#    Vercel خودکار این متغیر را ست می‌کند — نیازی به دستی نیست.
#
# 3) Supabase:
#    postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres
#
# 4) برای لوکال با SQLite (توسعه سریع بدون نصب Postgres):
#    در prisma/schema.prisma مقدار provider را به‌طور موقت به "sqlite" برگردانید،
#    سپس DATABASE_URL="file:./db/custom.db" را استفاده کنید.

# --- محیط اجرا ---
# در Vercel به‌صورت خودکار "production" تنظیم می‌شود.

# --- اختیاری ---
# NEXT_PUBLIC_SITE_URL="https://your-project.vercel.app"
# ZAI_API_KEY=""
